---
import PhotoCard from '../components/PhotoCard.astro';
import Layout from '../layouts/Layout.astro';
import { getGalleryCategories } from '../data/gallery';
import { sitePath } from '../data/site';
const categories = getGalleryCategories();
const featuredAlbums = categories.flatMap((category) => category.albums.slice(0, 1).map((album) => ({ album, categoryTitle: category.title })));
const services = [
	{ number: '01', title: 'Fotografía', text: 'Eventos, retratos y sesiones para clientes, usando por las referencias que elija.' },
	{ number: '02', title: 'Videografía', text: 'Cobertura de eventos y proyectos en 4K, con atención a cada momento.' },
	{ number: '03', title: 'Edición', text: 'Reels y cortometrajes terminados con el ritmo y estilo de su preferencia.' },
	{ number: '04', title: 'Manejo de redes', text: 'Contenido, publicaciones e historias diarias, con planificación mensual.' },
];
const offers = [
	{ category: 'foto', title: 'Fotografía de eventos', text: 'Los momentos que no se repiten.' }, { category: 'foto', title: 'Fotografía para clientes', text: 'Sesiones con sus propias referencias.' }, { category: 'foto', title: 'Retoque fotográfico', text: 'El acabado final, a su elección.' },
	{ category: 'video', title: 'Video de eventos', text: 'Grabación en 4K 10-bit.' }, { category: 'video', title: 'Video para clientes', text: 'Una historia con su propia mirada.' },
	{ category: 'edicion', title: 'Reels editados', text: 'A partir de los archivos que usted grabó.' }, { category: 'edicion', title: 'Cortometrajes', text: 'Un estilo hecho para su historia.' },
	{ category: 'redes', title: 'Creación de reels', text: 'Ideas que ponen su negocio en movimiento.' }, { category: 'redes', title: 'Publicaciones y carruseles', text: 'Fotos y videos listos para publicar.' }, { category: 'redes', title: 'Historias diarias', text: 'Presencia constante en redes sociales.' },
];
---
<Layout>
	<main>
		<section class="shell hero" id="inicio"><div class="hero-copy"><span class="hero-pill">Foto · Video · Edición en Cienfuegos</span><h1>El estudio para capturar <span>sus mejores momentos.</span></h1><p>Foto y video para eventos y clientes, edición de sus propios videos y manejo de redes. Un equipo, todo el contenido.</p><div class="button-row"><a class="button" href="https://wa.me/5355192915?text=Hola%2C%20quisiera%20agendar%20una%20cita." target="_blank" rel="noopener noreferrer">Agendar cita <span aria-hidden="true">↗</span></a><a class="button button-quiet" href={sitePath('fotos/')}>Ver galería <span aria-hidden="true">↗</span></a></div><div class="hero-stats" aria-label="Características del estudio"><div><strong>24 MP</strong><span>Fotografía</span></div><div><strong>4K 10-bit</strong><span>Videografía</span></div><div><strong>24 h</strong><span>Servicio de redes</span></div><div><strong>3</strong><span>Servicios principales</span></div></div></div><div class="hero-art" role="img" aria-label="Cámara Nikon Z50 II"><img class="hero-camera" src={sitePath('assets/camera-z50-ii.webp')} alt="" width="375" height="275" fetchpriority="high" /><div class="hero-label">4K 10-bit<br /><span>Nikon Z50 II</span></div></div></section>
		<section class="shell section" id="servicios"><div class="section-heading"><span class="eyebrow">Un lugar para capturar todo</span><h2>Una mirada para cada historia.</h2><p>Fotografía, video, edición y redes para los momentos que importan y las ideas que quiere compartir.</p></div><div class="service-grid">{services.map((service) => <article class="service-card"><span class="service-number">{service.number} / SERVICIO</span><h3>{service.title}</h3><p>{service.text}</p></article>)}</div></section>
		<section class="shell section section-tight"><div class="section-heading"><span class="eyebrow">A su propio ritmo</span><h2>Empiece simple. Crezca cuando quiera.</h2><p>Un servicio o un plan completo de contenido, siempre con un mismo equipo.</p></div><div class="feature-grid"><article class="feature-card"><h3>Todo listo, en un solo lugar</h3><p>Foto, video, edición y redes. Cuéntenos su idea y ponemos el equipo en marcha.</p><span class="feature-figure">Foto · Video · Redes</span></article><article class="feature-card"><h3>Su estilo, su elección</h3><p>El encuadre, el ritmo y el nivel de retoque parten de las referencias que usted comparta.</p><span class="feature-figure">A su manera</span></article><article class="feature-card"><h3>Contenido constante</h3><p>Planificación mensual y presencia diaria para mantener a su comunidad al tanto.</p><span class="feature-figure">24 h al día</span></article></div></section>
		<section class="shell section section-tight"><div class="section-heading"><span class="eyebrow">Servicios a su medida</span><h2>Elija un servicio, empiece a crear.</h2><p>Un primer paso claro, con opciones para cada proyecto.</p></div><div class="filter-row" data-offer-filters aria-label="Filtrar servicios"><button class="filter-button" type="button" aria-pressed="true" data-filter="todos">Destacados</button><button class="filter-button" type="button" aria-pressed="false" data-filter="foto">Foto</button><button class="filter-button" type="button" aria-pressed="false" data-filter="video">Video</button><button class="filter-button" type="button" aria-pressed="false" data-filter="edicion">Edición</button><button class="filter-button" type="button" aria-pressed="false" data-filter="redes">Redes</button></div><div class="offer-grid">{offers.map((offer) => <article class="offer" data-offer={offer.category}><strong>{offer.title}</strong><span>{offer.text}</span></article>)}</div></section>
		<section class="shell section section-tight" id="trabajos"><div class="section-heading"><span class="eyebrow">Trabajo reciente</span><h2>Del momento al recuerdo.</h2><p>Eventos, retratos y negocios en Cienfuegos.</p></div><div class="showcase-grid">{featuredAlbums.length > 0 ? featuredAlbums.map((item) => <PhotoCard album={item.album} categoryTitle={item.categoryTitle} />) : <p class="empty-gallery">Pronto encontrará aquí nuestros trabajos recientes.</p>}</div><div class="button-row" style="justify-content:center;margin-top:26px"><a class="button button-quiet" href={sitePath('fotos/')}>Explorar todas las galerías <span aria-hidden="true">↗</span></a></div></section>
		<section class="shell section section-tight"><div class="section-heading"><span class="eyebrow">Dos formas de trabajar</span><h2>Para sus momentos y su negocio.</h2></div><div class="plan-grid"><article class="plan"><h3>Momentos</h3><p>Para eventos y clientes que quieren conservar lo importante. Agende su cita y comparta sus referencias.</p><a class="button button-quiet" href="https://wa.me/5355192915?text=Hola%2C%20quisiera%20agendar%20una%20cita." target="_blank" rel="noopener noreferrer">Agendar cita <span aria-hidden="true">↗</span></a></article><article class="plan"><h3>Marketing</h3><p>Contenido constante para negocios: reels, publicaciones, historias y planificación mensual.</p><a class="button" href="https://wa.me/5354857017?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20el%20servicio%20de%20marketing." target="_blank" rel="noopener noreferrer">Hablar con el equipo <span aria-hidden="true">↗</span></a></article></div></section>
		<section class="shell section section-tight" id="proceso"><div class="section-heading"><span class="eyebrow">De la idea a la entrega</span><h2>Cómo trabajamos.</h2></div><div class="process-grid"><article class="process-card"><span>01</span><h3>Agende su cita</h3><p>Escríbanos para consultar fechas y reservar.</p></article><article class="process-card"><span>02</span><h3>Comparta sus referencias</h3><p>Cuéntenos el estilo que imagina para su foto o video.</p></article><article class="process-card"><span>03</span><h3>Reciba su contenido</h3><p>Con el acabado y la edición que usted elija.</p></article></div></section>
		<section class="shell section section-tight" id="faq"><div class="section-heading"><span class="eyebrow">Respuestas claras</span><h2>Preguntas frecuentes.</h2></div><div class="faq-list"><details><summary>¿Cómo agendo un servicio?</summary><p>Escríbanos por WhatsApp para reservar su fecha. Después, comparta las referencias para su fotografía o video.</p></details><details><summary>¿Qué calidad tienen las fotos?</summary><p>Entregamos archivos de 24 MP, tomados con una Nikon D7200.</p></details><details><summary>¿Pueden editar videos que grabé yo?</summary><p>Sí. Envíe sus archivos y les damos forma como reel o cortometraje, con el estilo que prefiera.</p></details><details><summary>¿Qué incluye el manejo de redes?</summary><p>Reels, publicaciones, historias diarias y planificación mensual del contenido, con servicio de 24 horas.</p></details></div></section>
		<section class="contact-band" id="cita"><span class="eyebrow">Effer Glass · Cienfuegos</span><h2>Capture su momento.</h2><a class="button" href="https://wa.me/5355192915?text=Hola%2C%20quisiera%20agendar%20una%20cita." target="_blank" rel="noopener noreferrer">Agendar cita <span aria-hidden="true">↗</span></a></section>
	</main>
</Layout>
<script>
	const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-offer-filters] [data-filter]'));
	const offerCards = Array.from(document.querySelectorAll<HTMLElement>('[data-offer]'));
	filterButtons.forEach((button) => button.addEventListener('click', () => { const filter = button.dataset.filter; filterButtons.forEach((option) => option.setAttribute('aria-pressed', String(option === button))); offerCards.forEach((offer) => { offer.hidden = filter !== 'todos' && offer.dataset.offer !== filter; }); }));
</script>